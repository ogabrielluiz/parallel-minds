filters:
  and:
    # Task files are identified by their frontmatter, not their folder path —
    # this is vault-position-independent. Every task file carries `kind` and
    # `inbox`; nothing else in the vault does. (If you'd rather scope by folder,
    # replace these with file.inFolder("<vault-relative path to your tasks/ dir>").)
    - kind != ""
    - inbox != ""
formulas:
  display_status: if(status == "new", "1 To Do", if(status == "claimed", "1 To Do", if(status == "progress", "2 In Progress", if(status == "blocked", "3 Blocked", if(status == "done", "4 Done", "Unknown")))))
  age_days: (now() - file.ctime).days.round(0)
  label: '[if(priority == "critical", "🔴", if(priority == "high", "🟠", if(priority == "medium", "🟡", ""))), if(kind == "review", "🔍", if(kind == "re-review", "🔁", if(kind == "address", "✍️", if(kind == "ci-fix", "🔧", if(kind == "verify-fix", "☑️", if(kind == "merge-comment", "🔗", if(kind == "transition", "➡️", if(kind == "triage", "🩺", if(kind == "respond", "💬", if(kind == "merge", "🔀", if(kind == "advisory", "🛡️", if(kind == "vuln", "🚨", if(kind == "mention", "📣", if(kind == "activity", "📡", "▫️")))))))))))))), kind].join(" ").trim()'
properties:
  status:
    displayName: Status
  kind:
    displayName: Kind
  key:
    displayName: Key
  via:
    displayName: Source loop
  linked:
    displayName: Linked
  title:
    displayName: Title
  created:
    displayName: Created
  due:
    displayName: Due
  refreshed:
    displayName: Refreshed
  closed:
    displayName: Closed
  priority:
    displayName: Priority
  auto:
    displayName: Auto override
  block_reason:
    displayName: Blocked because
  source:
    displayName: Found via
  inbox:
    displayName: Inbox
  url:
    displayName: Link
  attack:
    displayName: Attack class
  repro:
    displayName: Repro
  file_ref:
    displayName: File
  formula.age_days:
    displayName: Age (days)
  formula.display_status:
    displayName: Column
  formula.label:
    displayName: Task
views:
  - type: cards
    name: Board
    filters:
      and:
        - status != "done"
    groupBy:
      property: formula.display_status
      direction: ASC
    order:
      - formula.label
      - title
      - kind
      - key
      - priority
      - due
      - block_reason
  - type: cards
    name: By kind
    filters:
      and:
        - status != "done"
    groupBy:
      property: kind
      direction: ASC
    order:
      - formula.label
      - title
      - key
      - status
      - priority
      - due
  - type: table
    name: All open
    filters:
      and:
        - status != "done"
    order:
      - due
    properties:
      - file.name
      - kind
      - key
      - url
      - status
      - via
      - priority
      - due
      - refreshed
      - block_reason
  - type: table
    name: Done log
    filters:
      and:
        - status == "done"
    order:
      - closed desc
    properties:
      - file.name
      - kind
      - key
      - closed
      - via
      - title
